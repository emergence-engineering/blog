{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "jsx": "preserve",
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["articles/react-prosemirror/editors/lib/*"]
    }
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "articles/react-prosemirror/e2e",
    "articles/react-prosemirror/scripts",
    "articles/react-prosemirror/playwright.perf.config.ts"
  ]
}
